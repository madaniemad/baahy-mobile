<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own system splash and ignores the layer-list in
         windowBackground, falling back to plain white/black. Give it the brand
         tiffany so the splash matches iOS and older Android (Dark Mode off). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splashBg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splashBg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
